FLASK_APP=run.py
FLASK_DEBUG=1
FLASK_RUN_PORT=5555
# Required in production. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
DATABASE_URL=
MAX_CONTENT_LENGTH=16777216

# OCR local (Tesseract binary must be installed: Windows -> winget install UB-Mannheim.TesseractOCR ; Ubuntu -> apt install tesseract-ocr tesseract-ocr-spa)
OCR_ENABLED=true
OCR_LANGUAGES=spa+eng
OCR_MIN_CHARS=20
OCR_MAX_IMAGE_DIMENSION=2000

# LLM supervisor — optional escalation when OCR/heuristics produce low confidence.
# Switch between saved presets by changing LLM_SUPERVISOR_ACTIVE.
#   off = disabled (default, no cost)
#   1   = preset 1 (Anthropic Haiku 4.5, recommended, cheap + vision)
#   2   = preset 2 (Anthropic Sonnet 4.6, more capable)
#   3   = preset 3 (OpenAI gpt-5-nano, text only, ultra cheap)
# Fill the keys once; switch providers any time by editing this one line.
LLM_SUPERVISOR_ACTIVE=off

# --- Preset 1: Anthropic Claude Haiku 4.5 ---
LLM_SUPERVISOR1_ENABLED=true
LLM_SUPERVISOR1_PROVIDER=anthropic
LLM_SUPERVISOR1_MODEL=claude-haiku-4-5-20251001
LLM_SUPERVISOR1_API_KEY=

# --- Preset 2: Anthropic Claude Sonnet 4.6 ---
LLM_SUPERVISOR2_ENABLED=true
LLM_SUPERVISOR2_PROVIDER=anthropic
LLM_SUPERVISOR2_MODEL=claude-sonnet-4-6
LLM_SUPERVISOR2_API_KEY=

# --- Preset 3: OpenAI gpt-5-nano ---
LLM_SUPERVISOR3_ENABLED=true
LLM_SUPERVISOR3_PROVIDER=openai
LLM_SUPERVISOR3_MODEL=gpt-5-nano
LLM_SUPERVISOR3_API_KEY=
