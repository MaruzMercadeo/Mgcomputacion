FLASK_ENV=development
SECRET_KEY=change-this-in-production
DATABASE_URL=
MAX_CONTENT_LENGTH=16777216

# Red: 0.0.0.0 = visible desde la red local. 127.0.0.1 = solo esta maquina.
HOST=0.0.0.0
PORT=5555

# Depurador: vacio = activo solo si HOST es 127.0.0.1.
# No lo pongas en 1 con HOST=0.0.0.0 fuera de una red de confianza.
FLASK_DEBUG=
