FLASK_APP=run.py
FLASK_DEBUG=1
FLASK_RUN_PORT=5555
# Required in production. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
DATABASE_URL=
MAX_CONTENT_LENGTH=16777216

# OCR local (Tesseract binary must be installed: Windows -> winget install UB-Mannheim.TesseractOCR ; Ubuntu -> apt install tesseract-ocr tesseract-ocr-spa)
OCR_ENABLED=true
OCR_LANGUAGES=spa+eng
OCR_MIN_CHARS=20
OCR_MAX_IMAGE_DIMENSION=2000

# LLM supervisor (optional escalation when heuristics produce low-confidence results)
LLM_SUPERVISOR_ENABLED=false
LLM_SUPERVISOR_PROVIDER=
LLM_SUPERVISOR_MODEL=
LLM_SUPERVISOR_API_KEY=
